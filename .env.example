# Copy this file to .env at the repo root and fill in a real key.
# Used by rag/provider.py for the AI assistant features (narration, methodology Q&A, literature
# search) -- everything else in the app works fine without it.

# Required: an NVIDIA NIM API key. Get one at https://build.nvidia.com/.
NVIDIA_API_KEY=

# Optional -- defaults shown, only override if you're pointing at a different endpoint/model.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# (was nvidia/nemotron-3-ultra-550b-a55b -- NVIDIA broke that model's serverless function; see rag/provider.py)
